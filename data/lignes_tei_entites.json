  },
  {
    "xml_id": "f17-eSc_textblock_ff84f35e-eSc_line_58f149a9-lineCount24-text",
    "texte": "parce que les batteurs navoitn"
  },
  {
    "xml_id": "f17-eSc_textblock_ff84f35e-eSc_line_45fa1999-lineCount25-text",
    "texte": "pas encore ‸ achevé"
  },
  {
    "xml_id": "f17-eSc_textblock_ff84f35e-eSc_line_d1278904-lineCount26-text",
    "texte": "X tout"
  },
  {
    "xml_id": "f17-eSc_textblock_ff84f35e-eSc_line_5f8d36dd-lineCount27-text",
    "texte": "pendant que ne avions les batteurs ns"
  },
  {
    "xml_id": "f17-eSc_textblock_ff84f35e-eSc_line_15408acb-lineCount28-text",
    "texte": "eumes un Proseli[te]s nom̃é George il"
  },
  {
    "xml_id": "f17-eSc_textblock_ff84f35e-eSc_line_ef9ffa83-lineCount29-text",
    "texte": "s'en alla je ne lai plus jamais revus"
  },
  {
    "xml_id": "f17-eSc_textblock_75405ba9-eSc_line_1706f5b2-lineCount30-text",
    "texte": "13"
  },
  {
    "xml_id": "f18-eSc_textblock_0a3a6be4-eSc_line_215fb254-lineCount1-text",
    "texte": "14"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_98e6178c-lineCount2-text",
    "texte": "1736."
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_6ae6986e-lineCount3-text",
    "texte": "Le soir du nouvel an Mon Pere"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_c62ddfd9-lineCount4-text",
    "texte": "et Ma Mere, farent souper chez"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_155486b8-lineCount5-text",
    "texte": "Monsieur le Mayre. Abramelet"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_d6b896b3-lineCount6-text",
    "texte": "chez Etieñe etoit aupres de moy pour"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_540431a6-lineCount7-text",
    "texte": "me passer le tems pendant ce soir"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_429aeb1b-lineCount8-text",
    "texte": "pen[dan]dant le Mois de Janvier"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_6552ac52-lineCount9-text",
    "texte": "nous eumes la Suson chez Motche¬"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_e5d7fa19-lineCount10-text",
    "texte": "¬ran, pendant quelle étoit ici nous-"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_cc28789c-lineCount11-text",
    "texte": "avions la Margerite chez Greusillon"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_168ab36c-lineCount12-text",
    "texte": "et les Tailleurs Jacob de Plagne &c."
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_85225aad-lineCount13-text",
    "texte": "Pendant que la filleuse et la Mar¬"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_8d76359b-lineCount14-text",
    "texte": "¬guerite étoit ici Mʳ Le Baillif"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_098e1dae-lineCount15-text",
    "texte": "Chemilleret [ete] fut chez nous."
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_484c6eb1-lineCount16-text",
    "texte": "je ne scais pas bien[s] laquelle de ces"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_36d7f0d8-lineCount17-text",
    "texte": "⁊. la Suson ou la Marg: alla la 1."
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_c3dd854c-lineCount18-text",
    "texte": "envoye, cepandant il y a beauoup"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_bedf426c-lineCount19-text",
    "texte": "d'apparence que ce fut la suson"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_d6febe4d-lineCount20-text",
    "texte": "pendant qu'elles etoient encore tous"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_0d5e5c43-lineCount21-text",
    "texte": "⁊. ici il y peut un Certain garci de qui"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_b36a8add-lineCount22-text",
    "texte": "ici"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_9b6ad12f-lineCount23-text",
    "texte": "la feme accoucha a la Rochenette"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_5f3c56a2-lineCount24-text",
    "texte": "[...]"
  },
  {
    "xml_id": "f18-eSc_textblock_ae6d01d2-eSc_line_80ad81a4-lineCount25-text",
    "texte": "qui fit beacoup de bruits, justement"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_a176d121-lineCount1-text",
    "texte": "cetoit quand Mr Chemilleret etoit"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_e5b57db4-lineCount2-text",
    "texte": "15"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_1715d712-lineCount3-text",
    "texte": "chez nous, cetoit euviron le lamava"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_8690a9c6-lineCount4-text",
    "texte": "le 16 Mars se firent les Nopces"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_c82ca69c-lineCount5-text",
    "texte": "de J Jagues chez Danion,ns avions"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_27cdbbbe-lineCount6-text",
    "texte": "encore lafileuse et la Marguerite"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_af81bf37-lineCount7-text",
    "texte": "je n'en ‸ pas pourtant bien sur que la 1"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_9c85b056-lineCount8-text",
    "texte": "n suis"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_0efe3424-lineCount9-text",
    "texte": "si fut encore, nous fumes moy &c chez"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_11f5e3a5-lineCount10-text",
    "texte": "Conrad ou se faisoient les nôces; le soir"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_e089d7be-lineCount11-text",
    "texte": "La Marguerite sen alla envoye peu"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_7e6c4aaa-lineCount12-text",
    "texte": "apres ces nôces, la Suson etoit deja"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_8bf22cf3-lineCount13-text",
    "texte": "envoye. le 26ⁱᵉᵐᵉ de Mars :/ du"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_d8e70ca6-lineCount14-text",
    "texte": "moin je le crois:/ il se fit une ecelipse"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_fb92e225-lineCount15-text",
    "texte": "de lune fort grande, que je vis [cetoit un]"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_5092892d-lineCount16-text",
    "texte": "la Marion Criblez vint chez nous"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_6a40a87f-lineCount17-text",
    "texte": "le lendemain."
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_0b5cddc3-lineCount18-text",
    "texte": "Pendant qu'elle etoit ici, nous chez ns"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_6f5c33e7-lineCount19-text",
    "texte": "un Plaidoyer où Mʳ [.] Chamilleret"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_7016da74-lineCount20-text",
    "texte": "fut juge ;"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_6b283670-lineCount21-text",
    "texte": "Mʳ le secretaire Jacob fut [chez]"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_7c4d95c0-lineCount22-text",
    "texte": "chez ns je ne scais si cetoit [d] avant"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_f8dea930-lineCount23-text",
    "texte": "ou apres le playdoyer, [ce] je crois"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_c9353d66-lineCount24-text",
    "texte": "pourtant que cetoit  avant, /: je n'en"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_90223627-lineCount25-text",
    "texte": "sçais rien :/"
  },
  {
    "xml_id": "f19-eSc_textblock_7285318b-eSc_line_f286d845-lineCount26-text",
    "texte": "un peu avant l'Ascension"
  }
]